{
    "$schema": "https://raw.githubusercontent.com/grafana/dsconfig/refs/heads/main/dsconfig/schema.json",
    "schemaVersion": "v1",
    "pluginType": "grafana-github-datasource",
    "pluginName": "GitHub",
    "docURL": "https://grafana.com/docs/plugins/grafana-github-datasource",
    "fields": [
        {
            "id": "github_plan",
            "key": "githubPlan",
            "label": "GitHub License Type",
            "valueType": "string",
            "target": "jsonData",
            "defaultValue": "github-basic",
            "validations": [
                {
                    "type": "allowedValues",
                    "values": [
                        "github-basic",
                        "github-enterprise-cloud",
                        "github-enterprise-server"
                    ]
                }
            ],
            "ui": {
                "component": "radio",
                "options": [
                    {
                        "label": "Free, Pro & Team",
                        "value": "github-basic"
                    },
                    {
                        "label": "Enterprise Cloud",
                        "value": "github-enterprise-cloud"
                    },
                    {
                        "label": "Enterprise Server",
                        "value": "github-enterprise-server"
                    }
                ]
            },
            "effects": [
                {
                    "when": "value != 'github-enterprise-server'",
                    "set": {
                        "github_url": ""
                    }
                }
            ]
        },
        {
            "id": "github_url",
            "key": "githubUrl",
            "label": "GitHub Enterprise Server URL",
            "valueType": "string",
            "target": "jsonData",
            "role": "endpoint.baseUrl",
            "dependsOn": "github_plan == 'github-enterprise-server'",
            "requiredWhen": "github_plan == 'github-enterprise-server'",
            "ui": {
                "component": "input",
                "placeholder": "http(s)://HOSTNAME/"
            }
        },
        {
            "id": "selected_auth_type",
            "key": "selectedAuthType",
            "label": "Authentication Type",
            "valueType": "string",
            "target": "jsonData",
            "role": "auth.discriminator",
            "defaultValue": "personal-access-token",
            "validations": [
                {
                    "type": "allowedValues",
                    "values": [
                        "personal-access-token",
                        "github-app"
                    ]
                }
            ],
            "ui": {
                "component": "radio",
                "options": [
                    {
                        "label": "Personal Access Token",
                        "value": "personal-access-token"
                    },
                    {
                        "label": "GitHub App",
                        "value": "github-app"
                    }
                ]
            }
        },
        {
            "id": "access_token",
            "key": "accessToken",
            "label": "Personal Access Token",
            "valueType": "string",
            "target": "secureJsonData",
            "role": "auth.bearer.token",
            "dependsOn": "selected_auth_type == 'personal-access-token'",
            "requiredWhen": "selected_auth_type == 'personal-access-token'",
            "ui": {
                "component": "input",
                "placeholder": "Personal Access Token"
            },
            "help": {
                "title": "Access Token & Permissions",
                "markdown": "#### How to create a access token\n\nTo create a new fine grained access token, navigate to [Personal Access Tokens](https://github.com/settings/personal-access-tokens/new) or refer the guidelines from [the Github documentation.](https://docs.github.com/en/authentication/keeping-your-account-and-data-secure/managing-your-personal-access-tokens#creating-a-fine-grained-personal-access-token)\n\n#### Repository access\n\nIn the **Repository access** section, Select the required repositories you want to use with the plugin.\n\n#### Permissions\n\nIn the repository permissions, Ensure to provide **read-only access** to the necessary section which you want to use with the plugin. **The plugin does not require any write access.**\nAlong with other permissions such as `Issues`, `Pull Requests`, ensure to provide read-only access to `Meta data` section as well.\nThis plugin does not require any org level permissions",
                "docURL": "https://docs.github.com/en/authentication/keeping-your-account-and-data-secure/managing-your-personal-access-tokens#creating-a-fine-grained-personal-access-token"
            }
        },
        {
            "id": "app_id",
            "key": "appId",
            "label": "App ID",
            "valueType": "string",
            "target": "jsonData",
            "dependsOn": "selected_auth_type == 'github-app'",
            "requiredWhen": "selected_auth_type == 'github-app'",
            "ui": {
                "component": "input",
                "placeholder": "App ID"
            }
        },
        {
            "id": "installation_id",
            "key": "installationId",
            "label": "Installation ID",
            "valueType": "string",
            "target": "jsonData",
            "dependsOn": "selected_auth_type == 'github-app'",
            "requiredWhen": "selected_auth_type == 'github-app'",
            "ui": {
                "component": "input",
                "placeholder": "Installation ID"
            }
        },
        {
            "id": "private_key",
            "key": "privateKey",
            "label": "Private Key",
            "valueType": "string",
            "target": "secureJsonData",
            "role": "auth.jwt.signingKey",
            "dependsOn": "selected_auth_type == 'github-app'",
            "requiredWhen": "selected_auth_type == 'github-app'",
            "ui": {
                "component": "textarea",
                "multiline": true,
                "rows": 7,
                "placeholder": "-----BEGIN CERTIFICATE-----"
            }
        },
        {
            "id": "caching_enabled",
            "key": "cachingEnabled",
            "description": "Enables the query caching wrapper in the plugin backend. Not exposed in the configuration editor; the backend currently enables caching for every datasource instance.",
            "valueType": "boolean",
            "target": "jsonData",
            "defaultValue": true,
            "tags": [
                "backend-only"
            ]
        }
    ],
    "groups": [
        {
            "id": "connection",
            "title": "Connection",
            "order": 1,
            "optional": true,
            "fieldRefs": [
                "github_plan",
                "github_url"
            ]
        },
        {
            "id": "authentication",
            "title": "Authentication",
            "order": 2,
            "fieldRefs": [
                "selected_auth_type",
                "access_token",
                "app_id",
                "installation_id",
                "private_key"
            ]
        }
    ],
    "relationships": [
        {
            "type": "group",
            "fields": [
                "app_id",
                "installation_id",
                "private_key"
            ],
            "description": "GitHub App credentials"
        },
        {
            "type": "pair",
            "fields": [
                "github_plan",
                "github_url"
            ],
            "description": "GitHub license type and the Enterprise Server base URL it enables"
        }
    ],
    "instructions": [
        {
            "msg": "The configuration editor renders no required-field markers (DataSourceDescription is rendered with hasRequiredFields=false); the requiredWhen rules in this schema encode the backend data contract instead.",
            "tags": [
                "ui"
            ]
        },
        {
            "msg": "Datasources created before selectedAuthType was introduced store only secureJsonData.accessToken; the backend defaults selectedAuthType to 'personal-access-token' when accessToken is set and selectedAuthType is empty.",
            "tags": [
                "legacy",
                "auth"
            ]
        },
        {
            "msg": "Datasources created before githubPlan was introduced may have jsonData.githubUrl set without a plan; the configuration editor treats any datasource with a non-empty githubUrl as 'github-enterprise-server', and falls back to 'github-basic' when neither githubPlan nor githubUrl is set.",
            "tags": [
                "legacy",
                "connection"
            ]
        },
        {
            "msg": "The configuration editor stores appId and installationId as strings, but the plugin backend accepts either a JSON string or a JSON number for both (unmarshalled as json.RawMessage and parsed to int64).",
            "tags": [
                "auth"
            ]
        },
        {
            "msg": "For 'github-enterprise-server', the backend derives API endpoints from githubUrl: '<githubUrl>/api/v3' for the REST API and '<githubUrl>/api/graphql' for the GraphQL API.",
            "tags": [
                "connection"
            ]
        }
    ]
}
